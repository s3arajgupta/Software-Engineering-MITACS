# GitHub Personal Access Token Pool for GitHubMiner and Data Collectors
# Provide one or more tokens (comma-separated) to enable automatic rate-limit rotation
GITHUB_TOKENS=ghp_exampleToken1,ghp_exampleToken2,ghp_exampleToken3

# Optional: Set request timeout in milliseconds (0 for unlimited)
REQUEST_TIMEOUT=0

# Default batch size (max 100)
BATCH_SIZE=10
